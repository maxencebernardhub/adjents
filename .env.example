# Copy this file to .env and fill in your values.
# Never commit .env — only .env.example is tracked by git.

# ── Local LLM (Ollama) ────────────────────────────────────────────────────────                                                                                
OLLAMA_BASE_URL=http://localhost:11434

# Recommended: qwen3.5:4b (3.4 GB, works on any machine with 8 GB+ RAM)                                                                                         
# Upgrade to qwen3.5:9b on machines with 16 GB+ unified memory
OLLAMA_DEFAULT_MODEL=qwen3.5:4b    

# Max parallel inference requests sent to Ollama                                                                                                                
# Must be ≤ OLLAMA_NUM_PARALLEL on the Ollama server side
# Increase on machines with large unified memory (e.g. 3 on 32 GB+)                                                                                             
OLLAMA_NUM_PARALLEL=1                       
MAX_CONCURRENT_LOCAL_REQUESTS=1
                                             
# ── Cloud LLM APIs (optional) ─────────────────────────────────────────────────                                                                                
# ANTHROPIC_API_KEY=your-key-here                                                                                                                             
# OPENAI_API_KEY=your-key-here                                                                                                                                  
# GOOGLE_API_KEY=your-key-here

# Max parallel cloud API calls (across all providers)
# Keep low to avoid rate limits; increase if you have high API tier
MAX_CONCURRENT_CLOUD_REQUESTS=3
                                                                                                                                                                  
# ── Storage ───────────────────────────────────────────────────────────────────                                                                                
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/adjents.db
# Unset by default: the backend uses <repo>/data/adjents.db.
CHROMA_PATH=./data/chroma  
